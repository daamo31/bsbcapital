{
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns"],
    "strict": true
  },
  "importMap": "./import_map.json",
  "lint": {
    "include": ["src/", "../shared/"],
    "exclude": ["src/testdata/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src/", "../shared/"],
    "exclude": ["src/testdata/"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
