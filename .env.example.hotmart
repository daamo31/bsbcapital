# Configuración de Hotmart - BSB Capital
# ===================================

# 🔧 CONFIGURACIÓN BÁSICA HOTMART
# --------------------------------
# ID del curso/producto real de BSB Capital
VITE_HOTMART_PRODUCT_ID=6308462

# URL del club de Hotmart (para referencia)
# https://hotmart.com/es/club/bsb-capital-fz-llc

# 🔐 CREDENCIALES API (OPCIONAL)
# --------------------------------
# Estas son opcionales para la integración iframe
# Solo necesarias si quieres usar la API completa
VITE_HOTMART_CLIENT_ID=tu_client_id_aqui
VITE_HOTMART_CLIENT_SECRET=tu_client_secret_aqui

# 🎯 CONFIGURACIONES DE LA INTEGRACIÓN EMBEBIDA
# -----------------------------------------------
# Modo de integración por defecto
VITE_HOTMART_EMBED_MODE=true

# Configuraciones del reproductor
VITE_HOTMART_AUTOPLAY=false
VITE_HOTMART_CONTROLS=true
VITE_HOTMART_BRANDING=false

# 📝 INSTRUCCIONES DE USO
# ========================
# 1. Copia este archivo como .env.local en la raíz del proyecto
# 2. El ID 6308462 ya está configurado y funcionará para tus demos
# 3. Para usar la API completa, configura CLIENT_ID y CLIENT_SECRET
# 4. La integración iframe funcionará sin credenciales API

# 🚀 URLs DE ACCESO A LAS DEMOS
# ==============================
# • Demo profesional: /content/hotmart-professional-integration  
# • Ejemplo de uso: /examples/ejemplo-uso-hotmart
# • Lista completa: /test-navigation

# 💡 NOTAS IMPORTANTES
# ====================
# - ID 6308462 es tu producto real de BSB Capital
# - La integración iframe funciona sin API credentials
# - Para testing completo, visita /test-navigation
# - El archivo .htaccess ya está optimizado para iframes