# Configuración de Hotmart API
# Copia este archivo como .env.local y completa con tus credenciales reales

# Credenciales de Hotmart (obtenlas desde https://developers.hotmart.com/)
REACT_APP_HOTMART_CLIENT_ID=tu_client_id_aqui
REACT_APP_HOTMART_CLIENT_SECRET=tu_client_secret_aqui

# IDs de productos en Hotmart (mapeo de contenido interno -> producto Hotmart)
REACT_APP_HOTMART_BASIC_PRODUCT_ID=12345
REACT_APP_HOTMART_STANDARD_PRODUCT_ID=12346
REACT_APP_HOTMART_PREMIUM_PRODUCT_ID=12347
REACT_APP_HOTMART_FULL_ACADEMIA_ID=12348

# URLs base (normalmente no necesitas cambiar estas)
REACT_APP_HOTMART_API_BASE=https://developers.hotmart.com/payments
REACT_APP_HOTMART_AUTH_BASE=https://api-sec-vlc.hotmart.com/security/oauth/token

# Configuración adicional
REACT_APP_HOTMART_TIMEOUT=10000
REACT_APP_USE_HOTMART_VERIFICATION=true